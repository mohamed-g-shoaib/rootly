{
  "manifest_version": 3,
  "name": "Rootly",
  "version": "0.0.1",
  "description": "A side-panel study companion for quick Rootly capture while you browse.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://rootly.app/*",
    "https://www.rootly.app/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Rootly side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "https://rootly.app/*",
        "https://www.rootly.app/*"
      ],
      "run_at": "document_start",
      "js": ["content-script.js"]
    }
  ]
}
